# .dockerignore file
# These files/folders will NOT be copied into the Docker image
# (same concept as .gitignore)

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv
env.bak
venv.bak

# IDEs
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
*.ipynb

# Documentation
docs/
README.md
LICENSE

# Docker
Dockerfile*
docker-compose*
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# OS
.DS_Store
Thumbs.db

# Temporary
*.tmp
temp/
tmp/

# Testing
.pytest_cache
.coverage
htmlcov/

# Logs
*.log
logs/

# ============================================================================
# BENEFITS OF .dockerignore:
# 1. Smaller image size (doesn't include unnecessary files)
# 2. Faster builds (less context to process)
# 3. Security (doesn't copy sensitive files like .env, .git)
# 4. Cleaner images
# ============================================================================
